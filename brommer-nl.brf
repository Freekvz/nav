# Brommer NL (geel kenteken, max 45 km/u)
# - nooit: snelweg, autoweg (motorroad), trunk, fietspaden/paden zonder moped=yes/designated,
#   voetpaden, wegen met moped=no of motor_vehicle=no (tenzij moped=yes/designated)
# - wel: fiets/bromfietspaden (moped=designated/yes), gewone wegen, fietsstraten
# - vermijdt: moped/bicycle=use_sidepath, snelle wegen met parallel fietspad, onverharde paden

---context:global

assign downhillcost 0
assign downhillcutoff 0
assign uphillcost 0
assign uphillcutoff 0

assign validForBikes 1
assign validForCars 1

assign turnInstructionMode = 1

---context:way

assign turncost = if junction=roundabout then 0 else 40

assign initialclassifier = if route=ferry then 1 else 0
assign initialcost = if route=ferry then 20000 else 0

assign ispaved = or surface= surface=paved|asphalt|concrete|paving_stones|sett|concrete:plates|concrete:lanes|metal|wood|compacted

assign isbikepath = or highway=cycleway and highway=path bicycle=designated
assign isfootish = highway=footway|pedestrian|steps|bridleway|corridor|platform|construction|proposed|abandoned|raceway|busway|via_ferrata|elevator
assign isroad = highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link|unclassified|residential|living_street|service|road

assign mvaccess =
  if motor_vehicle= then
    ( if vehicle= then
        ( if access= then true
          else access=yes|designated|destination|permissive )
      else vehicle=yes|designated|destination|permissive )
  else motor_vehicle=yes|designated|destination|permissive

assign mvexplicit = or motor_vehicle=yes|designated|destination|permissive
                    or vehicle=yes|designated|destination|permissive
                       access=yes|designated|destination|permissive

assign mopedaccess =
  if moped=yes|designated|permissive|destination then true
  else if moped=no|private|agricultural|permit then false
  else if route=ferry then true
  else if highway=motorway|motorway_link|trunk|trunk_link then false
  else if motorroad=yes then false
  else if moped=use_sidepath then true
  else if isbikepath then false
  else if isfootish then false
  else if highway=track|path then mvexplicit
  else if isroad then mvaccess
  else false

assign isdestination = or access=destination or motor_vehicle=destination or vehicle=destination moped=destination

assign onewaypenalty =
  if ( if reversedirection=yes then
         ( if oneway= then junction=roundabout else oneway=yes|true|1 )
       else oneway=-1 )
  then 10000 else 0

assign isfastroad = maxspeed=70|80|90|100|110|120|130|rural
assign sidepathhint = or moped=use_sidepath
                      or bicycle=use_sidepath|no
                      or cycleway=track|opposite_track
                      or cycleway:both=separate|track
                      or cycleway:right=track|sidepath|opposite_track
                         cycleway:left=track|sidepath|opposite_track

assign basecost =
  if moped=use_sidepath then 20
  else if and isfastroad sidepathhint then 12
  else if isbikepath then ( if ispaved then 1.25 else 4 )
  else if highway=track|path then ( if ispaved then 2 else 6 )
  else if or cyclestreet=yes bicycle_road=yes then 1.5
  else if highway=primary|primary_link|secondary|secondary_link|tertiary|tertiary_link then ( if isfastroad then 1.35 else 1.0 )
  else if highway=unclassified then ( if isfastroad then 1.35 else 1.05 )
  else if highway=residential|road then 1.4
  else if highway=living_street then 2.5
  else if highway=service then ( if service=parking_aisle|drive-through|parking then 5 else 1.8 )
  else if route=ferry then 5.67
  else 2

assign costfactor =
  if not mopedaccess then 10000
  else add onewaypenalty multiply basecost ( if isdestination then 3 else 1 )

# voice hint classification
assign isresidentialorliving = or highway=residential|living_street living_street=yes

assign priorityclassifier =
  if      ( highway=motorway                  ) then  30
  else if ( highway=motorway_link             ) then  29
  else if ( highway=trunk                     ) then  28
  else if ( highway=trunk_link                ) then  27
  else if ( highway=primary                   ) then  26
  else if ( highway=primary_link              ) then  25
  else if ( highway=secondary                 ) then  24
  else if ( highway=secondary_link            ) then  23
  else if ( highway=tertiary                  ) then  22
  else if ( highway=tertiary_link             ) then  21
  else if ( highway=unclassified              ) then  20
  else if ( isresidentialorliving             ) then  6
  else if ( highway=service                   ) then  6
  else if ( highway=cycleway                  ) then  6
  else if ( highway=track                     ) then if tracktype=grade1 then 4 else 2
  else if ( highway=bridleway|road|path       ) then  2
  else 0

assign isbadoneway = not equal onewaypenalty 0
assign isgoodoneway = if reversedirection=yes then oneway=-1
                      else if oneway= then junction=roundabout else oneway=yes|true|1
assign isroundabout = junction=roundabout
assign islinktype = highway=motorway_link|trunk_link|primary_link|secondary_link|tertiary_link
assign isgoodforcars = if greater priorityclassifier 6 then true
                  else if ( or isresidentialorliving highway=service|cycleway ) then true
                  else if ( and highway=track tracktype=grade1 ) then true
                  else false

assign classifiermask add          isbadoneway
                      add multiply isgoodoneway   2
                      add multiply isroundabout   4
                      add multiply islinktype     8
                          multiply isgoodforcars 16

---context:node

assign hardbarrier = barrier=gate|lift_gate|swing_gate|block|jersey_barrier|chain|log|kissing_gate|stile|turnstile|full-height_turnstile|fence|wall|bar|rope|spikes|hedge|ditch|motorcycle_barrier

assign nodeaccessok = or access=yes|permissive|designated|destination
                      or motor_vehicle=yes|permissive|designated|destination
                         vehicle=yes|permissive|designated|destination

assign initialcost =
  if hardbarrier then ( if nodeaccessok then 0 else 1000000 )
  else if access=no|private then 1000000
  else 0
